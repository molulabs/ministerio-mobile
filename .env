# Shared defaults for development, committed. Personal overrides go in .env.local (git-ignored).
# Restart Metro after changing them: app.config.ts reads them when Metro starts.

# The API through the mobile port of the local nginx (infra/dev/nginx/mobile.conf).
# 10.0.2.2 is the host as seen from the Android emulator. A phone on the LAN needs the
# computer's IP instead, in .env.local: API_URL=http://192.168.x.x:8000
API_URL=http://10.0.2.2:8000
