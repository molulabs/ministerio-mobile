{
  "name": "censo-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@molulabs/ds": "github:molulabs/desing-system#v0.3.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "axios": "^1.21.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-network": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "fflate": "0.8.2",
    "formik": "^2.4.9",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.9",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "yup": "^1.7.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@molulabs))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
